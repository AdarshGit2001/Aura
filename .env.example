# Keep this value server-side. Never prefix the Gemini key with NEXT_PUBLIC_.
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash

# Optional links shown in the hackathon section / footer.
NEXT_PUBLIC_REPO_URL=https://github.com/your-team/aura
NEXT_PUBLIC_PPT_URL=https://drive.google.com/
